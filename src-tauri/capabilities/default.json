{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Main window capability: allow spawning the FrankenPHP sidecar",
    "windows": ["main"],
    "permissions": [
        "core:default",
        {
            "identifier": "shell:allow-execute",
            "allow": [
                {
                    "name": "binaries/frankenphp",
                    "sidecar": true
                }
            ]
        }
    ]
}
