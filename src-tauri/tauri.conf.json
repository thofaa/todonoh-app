{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "TODONOH",
    "version": "0.1.0",
    "identifier": "com.makoo.todonoh",
    "build": {
        "devUrl": "http://localhost:8000",
        "frontendDist": "./static"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "TODONOH",
                "width": 1200,
                "height": 800,
                "resizable": true,
                "url": "loader.html"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["deb", "appimage"],
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
        "resources": ["resources/laravel", "resources/bin"]
    }
}
